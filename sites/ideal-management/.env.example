# Ideal AI runs through OpenRouter — one key across many providers, including
# models that are free to call.
#
# For local development copy this file to .env and fill it in. In production
# these belong in the Netlify project's environment variables, never in the
# repository: anything committed here is public the moment the repo is.

# Required. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Optional. Comma-separated model ids, tried in order — a second id keeps the
# assistant answering when a free model hits its daily cap.
# Defaults to poolside/laguna-xs-2.1:free when unset.
OPENROUTER_MODEL=poolside/laguna-xs-2.1:free

# Optional. Point the calls at a proxy or a stand-in endpoint.
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=
