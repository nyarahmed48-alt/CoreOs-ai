# ---------------------------------------------------------------------------
# CoreOs Track — environment
# Copy to .env and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
# Local:    postgresql://postgres:postgres@localhost:5432/coreos_track?schema=public
# Supabase: postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/coreos_track?schema=public"

# Secret used to sign session cookies (HS256 JWT). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="change-me-to-a-long-random-string"

# Bootstrap admin. This account is always created/repaired as an approved admin,
# so access to the Security dashboard can never be lost.
ADMIN_EMAIL="nyarahmed48@gmail.com"
ADMIN_PASSWORD="ChangeMe123!"
