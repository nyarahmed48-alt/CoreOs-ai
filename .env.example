# CoreOS runs its agents through OpenRouter — one key across many providers,
# including models that are free to call.
#
# Copy this file to .env.local for local development, or set the variables in
# your hosting provider's environment settings.
#
# Without them the app still runs: every agent returns a clearly-labelled
# message saying no key is configured, instead of a real answer.

# Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Models: https://openrouter.ai/models — anything ending ":free" costs nothing.
#
# Required, with no default on purpose. Model ids on aggregators get renamed
# and retired, and a stale hardcoded one fails as "model not found" rather than
# anything that points at the cause. Setting the key without this logs what to
# do and leaves the agents switched off.
OPENROUTER_MODEL=

# Optional. Sent as the attribution header on OpenRouter calls.
OPENROUTER_SITE_URL=

# Optional. Point the calls at a proxy or a stand-in endpoint.
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=

# ---------------------------------------------------------------- database --
#
# The manager console at /manager. Without these it falls back to data/*.json,
# which only persists under `npm run dev` — the Worker has no filesystem.
# See supabase/README.md.

SUPABASE_URL=

# The SERVICE ROLE key, which bypasses Row Level Security. Server-side only.
#
# Never give this a VITE_ prefix and never read it from anything under src/:
# Vite inlines VITE_* into the browser bundle at build time, with no warning
# and no way to tell from the running site that it happened. The ledger is
# behind RLS precisely so that the publishable key cannot reach it; handing
# out this one instead undoes that in a single commit.
SUPABASE_SERVICE_ROLE_KEY=
