# CoreOS runs its agents through OpenRouter — one key across many providers,
# including models that are free to call.
#
# Copy this file to .env.local for local development, or set the variables in
# your hosting provider's environment settings.
#
# Without them the app still runs: every agent returns a clearly-labelled
# message saying no key is configured, instead of a real answer.

# Keys: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Models: https://openrouter.ai/models — anything ending ":free" costs nothing.
#
# Required, with no default on purpose. Model ids on aggregators get renamed
# and retired, and a stale hardcoded one fails as "model not found" rather than
# anything that points at the cause. Setting the key without this logs what to
# do and leaves the agents switched off.
OPENROUTER_MODEL=

# Optional. Sent as the attribution header on OpenRouter calls.
OPENROUTER_SITE_URL=

# Optional. Point the calls at a proxy or a stand-in endpoint.
# Defaults to https://openrouter.ai/api/v1
OPENROUTER_BASE_URL=


# ---------------------------------------------------------------------------
# The inbox responder
# ---------------------------------------------------------------------------
# Answers routine enquiries arriving from the /contact page, and emails you the
# draft before it goes out. Leave the three Google variables empty and the
# whole feature stays switched off — the rest of the site is unaffected.
#
# Setup is in the README, under "The inbox responder".

# An OAuth client of type "Desktop app" in Google Cloud, with the Gmail API
# enabled, plus a refresh token granted once for the mailbox being answered.
# Scope: https://www.googleapis.com/auth/gmail.modify — read, label, draft and
# send, but never permanently delete. `npm run inbox:auth` mints the token.
#
# Publish the OAuth app ("In production"). Google revokes refresh tokens after
# 7 days while the consent screen is still in "Testing".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# Where the "about to send this" notifications go.
# Defaults to the mailbox the responder is reading.
INBOX_OWNER_EMAIL=

# Minutes between the notification landing and the reply going out. This is
# your window to stop it. Default 20.
INBOX_HOLD_MINUTES=

# Set to false to make it draft and notify but never send on its own —
# a drafting assistant rather than an auto-responder. Default true.
INBOX_AUTOSEND=

# Ceilings. A runaway loop stops here rather than at your bill.
# Defaults: 20 auto-replies a rolling day, 10 new enquiries examined per run.
INBOX_MAX_PER_DAY=
INBOX_MAX_PER_RUN=

# Never auto-reply to the same person twice inside this many days (default 7),
# and never look at mail older than this many days (default 3).
INBOX_COOLDOWN_DAYS=
INBOX_LOOKBACK_DAYS=

# Signs the one-click "Stop it" / "Send now" links in the notification. Any
# long random string — `openssl rand -hex 32`. Without it the notification
# still arrives, just without buttons.
INBOX_ACTION_SECRET=

# Required before POST /api/inbox/scan will answer a request from anywhere but
# localhost. Netlify's scheduler doesn't need it; an external cron does.
INBOX_SCAN_SECRET=

# Where those links point. Default https://coreosai.netlify.app
INBOX_PUBLIC_URL=
